# Firebase Configuration
# This file is for documentation purposes only
# Firebase config is already in src/firebase/config.js

# No environment variables needed for this project
# All configuration is handled in the Firebase config file

# For production deployment:
# - Add your Firebase config to src/firebase/config.js
# - Enable Google Authentication in Firebase Console
# - Set up Realtime Database rules

# Example Firebase Config structure (already in config.js):
# VITE_FIREBASE_API_KEY=your_api_key
# VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
# VITE_FIREBASE_DATABASE_URL=https://your_project.firebaseio.com
# VITE_FIREBASE_PROJECT_ID=your_project
# VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
# VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
# VITE_FIREBASE_APP_ID=your_app_id
