{
  "rules": {
    "users": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid",
        "uid": {
          ".validate": "newData.val() === $uid"
        },
        "username": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 20"
        },
        "usernameNormalized": {
          ".validate": "newData.isString()"
        },
        "displayName": {
          ".validate": "newData.isString() && newData.val().length <= 50"
        },
        "bio": {
          ".validate": "newData.isString() && newData.val().length <= 150"
        },
        "photoURL": {
          ".validate": "newData.isString()"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "lastSeen": {
          ".validate": "newData.isNumber()"
        },
        "online": {
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "usernames": {
      "$username": {
        ".read": "auth !== null",
        ".write": "auth !== null",
        ".validate": "newData.isString()"
      }
    },
    "conversations": {
      "$conversationId": {
        ".read": "auth !== null && data.child('participants').child(auth.uid).exists()",
        ".write": "auth !== null && data.child('participants').child(auth.uid).exists()",
        "participants": {
          ".validate": "newData.hasChildren()"
        },
        "lastMessage": {
          ".validate": "newData.isString()"
        },
        "lastMessageAt": {
          ".validate": "newData.isNumber()"
        },
        "lastSenderId": {
          ".validate": "newData.isString()"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    "messages": {
      "$conversationId": {
        ".read": "auth !== null && root.child('conversations/' + $conversationId + '/participants/' + auth.uid).exists()",
        ".write": "auth !== null && root.child('conversations/' + $conversationId + '/participants/' + auth.uid).exists()",
        "$messageId": {
          "senderId": {
            ".validate": "newData.isString()"
          },
          "receiverId": {
            ".validate": "newData.isString()"
          },
          "text": {
            ".validate": "newData.isString()"
          },
          "createdAt": {
            ".validate": "newData.isNumber()"
          },
          "deliveredAt": {
            ".validate": "newData.isNumber()"
          },
          "seenAt": {
            ".validate": "newData.isNumber()"
          },
          "status": {
            ".validate": "newData.isString() && newData.val() in ['sent', 'delivered', 'seen', 'deleted']"
          },
          "deletedFor": {
            ".validate": "newData.isObject()"
          },
          "deletedForEveryone": {
            ".validate": "newData.isBoolean()"
          }
        }
      }
    },
    "presence": {
      "$uid": {
        ".read": "auth !== null",
        ".write": "$uid === auth.uid",
        "online": {
          ".validate": "newData.isBoolean()"
        },
        "lastSeen": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    "typing": {
      "$conversationId": {
        ".read": "auth !== null && root.child('conversations/' + $conversationId + '/participants/' + auth.uid).exists()",
        ".write": "auth !== null && root.child('conversations/' + $conversationId + '/participants/' + auth.uid).exists()",
        "$uid": {
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "calls": {
      "$callId": {
        ".read": "auth !== null && (data.child('callerId').val() === auth.uid || data.child('calleeId').val() === auth.uid)",
        ".write": "auth !== null && (data.child('callerId').val() === auth.uid || data.child('calleeId').val() === auth.uid)",
        "callerId": {
          ".validate": "newData.isString()"
        },
        "calleeId": {
          ".validate": "newData.isString()"
        },
        "type": {
          ".validate": "newData.isString() && newData.val() in ['voice', 'video']"
        },
        "status": {
          ".validate": "newData.isString() && newData.val() in ['calling', 'connected', 'rejected', 'ended', 'failed']"
        },
        "offer": {
          ".validate": "newData.isString()"
        },
        "answer": {
          ".validate": "newData.isString()"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "acceptedAt": {
          ".validate": "newData.isNumber()"
        },
        "endedAt": {
          ".validate": "newData.isNumber()"
        },
        "candidates": {
          "$candidateId": {
            "candidate": {
              ".validate": "newData.isString()"
            },
            "timestamp": {
              ".validate": "newData.isNumber()"
            }
          }
        }
      }
    },
    "blocks": {
      "$blockerId": {
        ".read": "$blockerId === auth.uid",
        ".write": "$blockerId === auth.uid",
        "$blockedId": {
          ".validate": "newData.isBoolean()"
        }
      }
    }
  }
}
